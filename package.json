{
  "name": "desicast",
  "version": "0.1.0",
  "private": true,
  "description": "Team SVG libraries and public icons for people and agents",
  "author": "Niall Young",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
